# ============================================================
# PyAI Suite — environment configuration
# Copy to .env and fill in what you have. ALL values are OPTIONAL
# for local development: the app runs end-to-end on the built-in
# MockProvider (deterministic, no network) so you can demo without
# any API keys. Real providers activate automatically when their
# keys are present.
# ============================================================

# ---- Core ----
NODE_ENV=development
LOG_LEVEL=info

# ---- Providers (all optional; presence enables the adapter) ----

# PyAI — primary/default provider
# Docs: https://docs.pyai.com/quickstart
# Instant sandbox key (no signup / email / card):
#   curl -sS -X POST https://api.pyai.com/v1/sandbox/keys
#   # → { "api_key": "pyai_test_…" }
# Or: pnpm --filter @pyai/cli start setup --sandbox
# Verify: curl https://api.pyai.com/v1/me -H "Authorization: Bearer $PYAI_API_KEY"
PYAI_API_KEY=
PYAI_BASE_URL=https://api.pyai.com

# OpenAI
OPENAI_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# ElevenLabs (STT/TTS)
ELEVENLABS_API_KEY=

# Deepgram (STT)
DEEPGRAM_API_KEY=

# Local OpenAI-compatible endpoint (Ollama / vLLM / Whisper server)
LOCAL_OPENAI_BASE_URL=
LOCAL_OPENAI_API_KEY=

# ---- Meeting bots (OpenGong) — Attendee is part of main docker compose ----
# Prebuilt Attendee+Chrome image (GHCR). Leave as-is so first setup is a pull,
# not a 5–10 min local Chrome build. Empty / pull failure → compose builds from source.
ATTENDEE_IMAGE=ghcr.io/praneethnagelli-saaslabs/pyai-suite/attendee:latest
# missing = pull if not cached. never = local only. always = re-pull on up.
ATTENDEE_PULL_POLICY=missing
# Docker Compose mints a local Attendee API key and injects it into the API
# process (shared volume). Leave ATTENDEE_API_KEY empty for that path.
# Set it only for non-Docker runs or to override the bootstrap key.
ATTENDEE_BASE_URL=http://attendee-app:8000
ATTENDEE_API_KEY=
# Local Attendee UI login (Compose default password is pyai-local-dev-only)
ATTENDEE_BOOTSTRAP_EMAIL=calliq@local.test
ATTENDEE_BOOTSTRAP_PASSWORD=
# Set to 1 to skip auto user/key creation
ATTENDEE_SKIP_BOOTSTRAP=
ATTENDEE_DJANGO_SECRET_KEY=dev-only-attendee-django-secret-change-me
ATTENDEE_CREDENTIALS_ENCRYPTION_KEY=8h7yMgt2CB87fCu_nRsv2g1e-7OS1WoCGGFVkDIPbRs=
# Hostnames Attendee accepts (must include Docker service name)
ATTENDEE_ALLOWED_HOSTS=localhost,127.0.0.1,attendee-app
# Seconds alone in Meet before bot auto-leaves (Attendee default is 60)
ATTENDEE_ALONE_TIMEOUT_SECONDS=20

# Attendee recordings → MinIO (S3-compatible), not AWS cloud
AWS_ENDPOINT_URL=http://minio:9000
AWS_RECORDING_STORAGE_BUCKET_NAME=attendee-recordings
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1

# ---- Infrastructure (used by docker compose; app degrades to in-memory) ----
DATABASE_URL=postgres://pyai:pyai@localhost:5432/pyai_suite
REDIS_URL=redis://localhost:6379
# memory | redis — leave unset to auto-detect Redis; use memory for local tests
JOBS_BACKEND=
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=pyai-suite

# ---- API ----
API_PORT=4000
API_HOST=0.0.0.0

# ---- Web ----
WEB_PORT=3000
VITE_API_BASE_URL=http://localhost:4000
# Used after Google OAuth callback
WEB_ORIGIN=http://localhost:3000

# ---- Google Meet (CallIQ: create Meet + bot joins same room, no extension) ----
# Google Cloud Console → APIs → enable Google Calendar API
# Create OAuth Client ID (Web) with redirect:
#   http://localhost:4000/api/google/oauth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/google/oauth/callback

# ---- Budgets (governor defaults; can be overridden per workflow) ----
BUDGET_MAX_COST_USD=0.50
BUDGET_MAX_TOKENS=200000
BUDGET_MAX_AUDIO_MINUTES=60
BUDGET_MAX_DURATION_MS=120000
BUDGET_MAX_RETRIES=4
BUDGET_MAX_PARALLEL=8

# ---- Retention (data classification; see docs/privacy.md) ----
RETENTION_AUDIO=90d
RETENTION_TRANSCRIPTS=forever
RETENTION_DERIVED=forever
RETENTION_EMBEDDINGS=forever
RETENTION_LOGS=30d
