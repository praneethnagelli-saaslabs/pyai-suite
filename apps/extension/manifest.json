{
  "manifest_version": 3,
  "name": "PyAI Suite",
  "version": "0.4.30",
  "description": "CallIQ bot join, Brief Meet capture, Scrib dictation. Secrets never touch content scripts.",
  "permissions": ["activeTab", "storage", "scripting", "tabs", "sidePanel", "offscreen", "clipboardWrite", "clipboardRead", "debugger"],
  "commands": {
    "scrib-toggle": {
      "description": "Scrib: hold to talk, release to paste",
      "suggested_key": {
        "default": "Ctrl+Shift+1",
        "mac": "MacCtrl+Shift+1"
      }
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "PyAI Suite",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["insert.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
