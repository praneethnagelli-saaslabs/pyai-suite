{
  "name": "@pyai/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "macOS menu-bar Scrib — hold Control+Shift+1, release to paste.",
  "scripts": {
    "dev": "bash scripts/start.sh",
    "quit": "bash scripts/quit.sh",
    "tauri:dev": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri dev",
    "tauri:build": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri build --bundles app",
    "build": "echo 'Desktop app is macOS-only; use pnpm --filter @pyai/desktop tauri:build (requires Rust)'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check src",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@pyai/scrib": "workspace:*"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
