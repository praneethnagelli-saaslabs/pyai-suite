    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/websocket": "^10.0.1",
    "@pyai/core": "workspace:*",
    "@pyai/db": "workspace:*",
    "@pyai/calliq": "workspace:*",
    "@pyai/brief": "workspace:*",
    "@pyai/simulator": "workspace:*",
    "@pyai/scrib": "workspace:*",
    "@pyai/worker": "workspace:*",
    "fastify": "^4.28.1",
    "thread-stream": "3.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
